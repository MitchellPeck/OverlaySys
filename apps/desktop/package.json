{
  "name": "@overlaysys/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron host for OverlaySys — operator window plus per-channel renderer windows",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && OVERLAYSYS_DESKTOP_DEV=1 OPERATOR_URL=http://localhost:3000 RENDERER_URL=http://localhost:3001 electron dist/main.js",
    "package": "node ../../scripts/package-desktop.mjs",
    "package:mac": "node ../../scripts/package-desktop.mjs --mac",
    "package:win": "node ../../scripts/package-desktop.mjs --win",
    "package:linux": "node ../../scripts/package-desktop.mjs --linux",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@overlaysys/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.overlaysys.desktop",
    "productName": "OverlaySys",
    "directories": {
      "output": "build/release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/staged",
        "to": "app",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }]
    }
  }
}
