{
  "name": "overlaysys",
  "private": true,
  "version": "0.0.1",
  "description": "Custom HTML broadcast graphics system (replacement for H2R).",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^4.1.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core"
    ]
  }
}
