# The shared bridge contract is published to GitHub Packages under the @ovation scope.
# Auth is supplied at install time via env (e.g. //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN});
# never commit a token here.
@ovation:registry=https://npm.pkg.github.com

# npm workspaces: tolerate the mixed peer ranges across the app/renderer/desktop
# graph (previously handled by pnpm's auto-install-peers).
legacy-peer-deps=true
