# deps
node_modules/
.pnpm-store/

# build
dist/
build/
.next/
out/
.turbo/
# companion-module's packaged release folder (build.mjs output)
release/

# env
.env
.env.local
.env.*.local
.env.production
.env.production.*

# editor / OS
.DS_Store
*.log
.idea/
.vscode/

# data (per-deployment, not source)
data/templates/*.json
data/shows/*.json
# Assets are content-addressed binaries pulled from a deployment or
# imported per-user. Never commit them — they balloon the repo and
# leak per-install content. Use a `**` glob so this catches everything
# under the folder, not just direct children.
data/assets/**
!data/assets/.gitkeep
!data/templates/.gitkeep
!data/shows/.gitkeep
!data/templates/fixtures/
!data/shows/fixtures/

# tsbuild
*.tsbuildinfo